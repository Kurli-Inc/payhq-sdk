{
  "name": "@kurli-inc/payhq-sdk",
  "version": "0.1.1",
  "description": "Lightweight TypeScript wrapper for the PayHQ (Payfirma) payment APIs: OAuth, customers, transactions, and card terminals",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --testPathPattern=tests/unit",
    "test:watch": "jest --watch --testPathPattern=tests/unit",
    "test:coverage": "jest --coverage --testPathPattern=tests/unit",
    "test:integration": "jest --testPathIgnorePatterns=tests/unit",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "payhq",
    "payfirma",
    "payment",
    "payments",
    "sdk",
    "typescript",
    "oauth"
  ],
  "author": "Kurli Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kurli-Inc/payhq-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Kurli-Inc/payhq-sdk/issues"
  },
  "homepage": "https://github.com/Kurli-Inc/payhq-sdk#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.5.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "moduleNameMapper": {
      "^../src/(.*)$": "<rootDir>/src/$1"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
